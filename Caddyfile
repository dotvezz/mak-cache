{
    debug
    metrics

    cache {
        timing {
            ttl 5s
            max_stale 1s
            ttl_splay 10s
        }

        metadata_storage otter {
            memory_limit 268435456 # 256mb
        }
        storage otter {
            memory_limit 268435456 # 256mb
        }
    }
}

http://localhost:8080 {
    route * {
        cache
        reverse_proxy localhost:8084 # the fileserver container from testing/containers
    }
}
