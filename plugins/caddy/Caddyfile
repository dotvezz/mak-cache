{
	debug
	metrics

	admin localhost:2019 {
		origins localhost:2019 127.0.0.1:2019 [::1]:2019 ""
	}

	cache {
		timing {
			ttl 100s
		}

		metadata in_memory 128MB
		entries in_memory 2GB
	}
}

:9090 {
	reverse_proxy /metrics* {
		to localhost:2019
		header_up Host {upstream_hostport}
	}
}

:8080 {
	route * {
		cache
		reverse_proxy localhost:8000
	}
}
